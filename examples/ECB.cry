module ECB where

parameter
  type Key: *
  type Block: *

  encipher, decipher: Key -> Block -> Block

encrypt, decrypt: {n} Key -> [n]Block -> [n]Block
encrypt key = map (encipher key)
decrypt key = map (decipher key)

/** @assume */
deciphers: (Eq Block) => Key -> Block -> Bool
deciphers key block = decipher key (encipher key block) == block

/** @guarantee */
decrypts: {n} (fin n, Eq Block) => Key -> [n]Block -> Bool
decrypts key blocks = decrypt key (encrypt key blocks) == blocks
