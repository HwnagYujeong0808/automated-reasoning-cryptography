// extract_rocq.saw
//
// Rocq extraction of the ECB and CBC wrappers (spec -> outputs/rocq). Run by
// ./replay.sh with CRYPTOLPATH=<repo>/examples, so the wrappers can find their
// parameterized modules.
//
// SAW resolves these paths against this script's directory, not the working
// directory, hence the leading "../".

write_rocq_cryptol_module "../examples/ECB/Wrapper.cry" "../outputs/rocq/ECB/Wrapper.v" [] [];
print "Extracted examples/ECB/Wrapper.cry to outputs/rocq/ECB/Wrapper.v";
write_rocq_cryptol_module "../examples/CBC/Wrapper.cry" "../outputs/rocq/CBC/Wrapper.v" [] [];
print "Extracted examples/CBC/Wrapper.cry to outputs/rocq/CBC/Wrapper.v";
